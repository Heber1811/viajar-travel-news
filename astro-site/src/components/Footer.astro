---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container-vtn site-footer__inner">
    <strong>Viajar Travel News</strong>
    <span>Turismo, histórias e experiências.</span>
    <span>© {year}</span>
  </div>
</footer>

<style>
  .site-footer{padding:1.5rem 0;background:#f6f5f0;color:#626a70}
  .site-footer__inner{display:flex;align-items:center;justify-content:space-between;gap:1rem;font-size:.82rem}
  strong{color:#3f484d;font-weight:800}
  @media(max-width:560px){.site-footer__inner{align-items:flex-start;flex-direction:column;gap:.55rem}}
</style>
