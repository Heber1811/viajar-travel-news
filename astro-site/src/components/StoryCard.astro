---
interface Props {
  category: string;
  title: string;
  description: string;
  href: string;
  image: string;
}
const { category, title, description, href, image } = Astro.props;
---

<article class="story-card">
  <a class="story-image" href={href} tabindex="-1" aria-hidden="true"><img src={image} alt="" loading="lazy" width="900" height="650" /></a>
  <div class="story-copy">
    <p>{category}</p>
    <h3><a href={href}>{title}</a></h3>
    <span>{description}</span>
    <a class="read-more" href={href}>Leia a matéria <span aria-hidden="true">→</span></a>
  </div>
</article>

<style>
  .story-card { display: grid; overflow: hidden; border: 1px solid #15202a12; border-radius: 4px; background: white; box-shadow: 0 15px 45px #1c242c0d; }
  .story-image { display: block; aspect-ratio: 4 / 3; overflow: hidden; }
  .story-image img { width: 100%; height: 100%; object-fit: cover; transition: transform .45s ease; }
  .story-card:hover .story-image img { transform: scale(1.035); }
  .story-copy { padding: 1.5rem; }
  .story-copy > p { margin: 0 0 .7rem; color: var(--color-vtn-orange); font-size: .7rem; font-weight: 800; letter-spacing: .15em; text-transform: uppercase; }
  h3 { margin: 0; font-family: var(--font-display); font-size: 1.55rem; font-weight: 400; line-height: 1.15; }
  h3 a { color: var(--color-vtn-ink); text-decoration: none; }
  .story-copy > span { display: block; margin-top: .9rem; color: #697178; font-size: .94rem; line-height: 1.65; }
  .read-more { display: inline-flex; gap: .6rem; margin-top: 1.25rem; color: var(--color-vtn-green); font-size: .74rem; font-weight: 800; letter-spacing: .08em; text-decoration: none; text-transform: uppercase; }
</style>
