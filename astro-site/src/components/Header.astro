---
import { navigation } from '../data/home';

const currentPath = Astro.url.pathname;
---

<header class="site-header" data-header>
  <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
  <div class="container-vtn header-inner">
    <a class="brand" href="/" aria-label="Viajar Travel News — página inicial">
      <img src="/assets/brand/logo.png" width="72" height="72" alt="" />
      <span>Viajar Travel News</span>
    </a>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="main-menu" data-menu-button>
      <span class="sr-only">Abrir menu</span>
      <span></span><span></span><span></span>
    </button>
    <nav id="main-menu" aria-label="Navegação principal" data-menu>
      <button class="search-button" type="button" data-search-button aria-expanded="false" aria-controls="site-search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6"></circle><path d="m16 16 4 4"></path></svg>
        Encontre aqui
      </button>
      {navigation.map((item) => {
        const itemPath = item.href.split('#')[0];
        const isActive = item.href === '/' ? currentPath === '/' : !item.href.includes('#') && currentPath === itemPath;
        return <a href={item.href} class:list={{ active: isActive }} aria-current={isActive ? 'page' : undefined}>{item.label}</a>;
      })}
    </nav>
  </div>
  <form id="site-search" class="search-panel" role="search" data-search-panel hidden>
    <label class="sr-only" for="search-input">Pesquisar em todo o site</label>
    <div class="search-field">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6"></circle><path d="m16 16 4 4"></path></svg>
      <input id="search-input" name="busca" type="search" placeholder="Pesquisar em todo o site…" autocomplete="off" />
      <button class="search-submit" type="submit">Buscar</button>
      <button class="search-close" type="button" data-search-close aria-label="Fechar pesquisa">×</button>
    </div>
    <p class="search-hint">Digite pelo menos 2 caracteres e pressione Enter</p>
  </form>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const searchButton = document.querySelector<HTMLButtonElement>('[data-search-button]');
  const searchPanel = document.querySelector<HTMLElement>('[data-search-panel]');
  const searchClose = document.querySelector<HTMLButtonElement>('[data-search-close]');
  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!open));
    button.setAttribute('aria-label', open ? 'Abrir menu' : 'Fechar menu');
    menu?.classList.toggle('is-open', !open);
  });
  const setSearchOpen = (open: boolean) => {
    searchButton?.setAttribute('aria-expanded', String(open));
    if (searchPanel) searchPanel.hidden = !open;
    if (open) searchPanel?.querySelector('input')?.focus();
  };
  searchButton?.addEventListener('click', () => setSearchOpen(searchButton.getAttribute('aria-expanded') !== 'true'));
  searchClose?.addEventListener('click', () => setSearchOpen(false));
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') setSearchOpen(false); });
  document.addEventListener('pointerdown', (event) => {
    if (!searchPanel?.hidden && !searchPanel?.contains(event.target as Node) && !searchButton?.contains(event.target as Node)) setSearchOpen(false);
  });
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; border-bottom: 1px solid #0000000d; background: #fffffff2; backdrop-filter: blur(16px); }
  .header-inner { display: flex; min-height: 86px; align-items: center; justify-content: space-between; gap: 2rem; }
  .brand { display: flex; align-items: center; gap: .8rem; color: var(--color-vtn-ink); text-decoration: none; }
  .brand img { width: 64px; height: 64px; object-fit: contain; }
  .brand span { font-family: var(--font-display); font-size: clamp(1.05rem, 2vw, 1.35rem); letter-spacing: .02em; }
  nav { display: flex; align-items: center; gap: 1.5rem; }
  nav a { position: relative; color: #3f464a; font-family: var(--font-display); font-size: .84rem; font-weight: 400; letter-spacing: .055em; text-decoration: none; text-transform: uppercase; }
  nav a::after { position: absolute; right: 0; bottom: -.55rem; left: 0; height: 2px; background: var(--color-vtn-orange); content: ''; transform: scaleX(0); transition: transform .2s ease; }
  nav a:hover::after, nav a:focus-visible::after { transform: scaleX(1); }
  nav a.active { color: #83b81e; }
  nav a.active::after { background: #83b81e; transform: scaleX(1); }
  .menu-button { display: none; border: 0; background: transparent; padding: .5rem; }
  .menu-button span:not(.sr-only) { display: block; width: 26px; height: 2px; margin: 5px; background: var(--color-vtn-ink); }
  .search-button { display: inline-flex; align-items: center; gap: .45rem; border: 1px solid #eef0ec; border-radius: 999px; padding: .78rem 1.25rem; background: white; box-shadow: 0 8px 24px #18232c14; color: #83b81e; font-family: var(--font-display); font-size: .78rem; font-weight: 400; letter-spacing: .075em; text-transform: uppercase; cursor: pointer; transition: box-shadow .2s, transform .2s; }
  .search-button:hover { box-shadow: 0 10px 28px #18232c22; transform: translateY(-1px); }
  .search-button svg, .search-field>svg { width: 15px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-width: 1.8; }
  .search-panel { position: absolute; top: calc(100% + 12px); right: max(1rem, calc((100% - 1180px) / 2)); width: min(430px, calc(100% - 2rem)); padding: .85rem; border: 1px solid #e5e7e3; border-radius: 20px; background: #fffffff8; box-shadow: 0 22px 55px #18232c2b; backdrop-filter: blur(18px); }
  .search-panel::before { position: absolute; top: -7px; right: 132px; width: 14px; height: 14px; border-top: 1px solid #e5e7e3; border-left: 1px solid #e5e7e3; background: white; content: ''; transform: rotate(45deg); }
  .search-field { display: flex; align-items: center; gap: .55rem; min-height: 52px; border: 1px solid #d9ddd8; border-radius: 13px; padding: .25rem .35rem .25rem .9rem; background: white; }
  .search-field>svg { flex: none; width: 18px; color: #8dbd2b; }
  .search-panel input { flex: 1; min-width: 0; border: 0; padding: .65rem .25rem; background: transparent; color: var(--color-vtn-ink); font: inherit; outline: 0; }
  .search-panel input::placeholder { color: #92989a; font-family: var(--font-display); font-style: italic; }
  .search-submit { border: 0; border-radius: 9px; padding: .7rem .9rem; background: var(--color-vtn-orange); color: white; font-size: .74rem; font-weight: 800; cursor: pointer; }
  .search-close { display: grid; flex: none; width: 34px; height: 34px; place-items: center; border: 0; border-radius: 50%; background: #edf0ed; color: #697176; font-size: 1.35rem; line-height: 1; cursor: pointer; }
  .search-hint { margin: .65rem .45rem .15rem; color: #777f82; font-size: .73rem; }
  .skip-link { position: fixed; left: 1rem; top: -5rem; z-index: 100; padding: .8rem 1rem; background: var(--color-vtn-ink); color: white; }
  .skip-link:focus { top: 1rem; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); }
  @media (max-width: 900px) {
    .menu-button { display: block; }
    nav { position: absolute; top: 86px; right: 0; left: 0; display: none; flex-direction: column; align-items: stretch; gap: 0; padding: .75rem 1rem 1.25rem; border-bottom: 1px solid #0001; background: white; box-shadow: 0 18px 35px #0002; }
    nav.is-open { display: flex; }
    nav a { padding: .9rem 1rem; }
    .search-button { margin-bottom: .5rem; }
    .search-panel { top: calc(100% + 8px); right: 1rem; left: 1rem; width: auto; }
    .search-panel::before { display: none; }
  }
  @media (max-width: 480px) { .search-submit { display: none; } }
</style>
