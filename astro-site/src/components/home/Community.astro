---
import { categories, videos } from '../../data/home-content';
const partners = [
  ['Farofino Rações','https://www.instagram.com/lojafarofinoracoes/','/assets/partners/farofino.jpg'],
  ['Villa Náutica','https://villanauticajeri.com/','/assets/partners/villa-nautica.png'],
  ['Toca da Coruja','https://tocadacoruja.com.br/','/assets/partners/toca-da-coruja.png'],
  ['Pousada Oasis','https://pousadaoasisgalinhos.com.br/','/assets/partners/oasis.png'],
  ['Hotel Canto das Águas','https://lencois.com.br/','/assets/partners/lencois.webp'],
] as const;
---
<section class="videos"><div class="container-vtn"><div class="heading"><div><p class="eyebrow">Experiências em movimento</p><h2 class="section-title">Viaje com a gente…</h2></div></div><div class="video-grid" id="travel-videos">{videos.map(([src,title,place],index)=><article class="video-card" hidden={index >= 4}><video controls preload="none" poster={src.replace('/assets/videos/','/assets/videos/posters/').replace('.mp4','.webp')} playsinline aria-label={`${title} — ${place}`}><source src={src} type="video/mp4"/></video><div class="video-copy"><p>{place}</p><h3>{title}</h3></div></article>)}</div><div class="video-actions"><button type="button" class="video-toggle" data-video-toggle aria-expanded="false" aria-controls="travel-videos"><span data-video-toggle-text>Ver mais vídeos</span><span aria-hidden="true">↓</span></button></div></div></section>

<script>
  const videoToggle = document.querySelector<HTMLButtonElement>('[data-video-toggle]');
  const extraVideos = document.querySelectorAll<HTMLElement>('.video-card:nth-child(n + 5)');
  const videoToggleText = videoToggle?.querySelector<HTMLElement>('[data-video-toggle-text]');
  const videoToggleArrow = videoToggle?.querySelector<HTMLElement>('[aria-hidden="true"]');

  videoToggle?.addEventListener('click', () => {
    const expanded = videoToggle.getAttribute('aria-expanded') === 'true';
    extraVideos.forEach((video) => { video.hidden = expanded; });
    videoToggle.setAttribute('aria-expanded', String(!expanded));
    if (videoToggleText) videoToggleText.textContent = expanded ? 'Ver mais vídeos' : 'Ver menos vídeos';
    if (videoToggleArrow) videoToggleArrow.textContent = expanded ? '↓' : '↑';
  });
</script>

<section id="conteudos-especiais" class="editorial-extras">
  <div class="container-vtn editorial-layout">
    <article class="moon-feature">
      <div class="moon-visual">
        <img src="/assets/moon/sempre-lua-cheia.jpeg" alt="Lua cheia entre os galhos de uma árvore" loading="lazy"/>
        <div class="moon-heading"><p class="eyebrow">Viajar Travel News</p><h2>Sempre na Lua Cheia</h2></div>
      </div>
      <div class="moon-copy">
        <div class="moon-story">
          <div class="moon-text">
            <p>Desde as mais remotas civilizações, o homem já se orientava pela Lua, para saber o momento certo do plantio, da colheita, caça e pesca, mudanças climáticas…</p>
            <p>Os antigos diziam que a Lua era um cálice vazio, enchendo e esvaziando devagar, representando as mudanças cíclicas das emoções e necessidades humanas.</p>
            <p>E é por acreditarmos na sua influência, especialmente a cheia, quando o seu lado iluminado está de frente para a Terra e a luz plena e oposta ao Sol amplia o campo magnético, que o nosso site é atualizado sempre às luas cheias.</p>
            <p>Em sintonia positiva com essa energia, levamos até você, por meio das nossas matérias e sob a magia e o magnetismo dessa luz arrebatadora, os lugares mais inspiradores.</p>
            <p class="moon-signature">Porque viajar é a melhor inspiração.</p>
          </div>
          <a class="curiango-card" href="/curiango.html">
            <img src="/assets/about/curiango-bacurau-comum.webp" alt="Curiango pousado em um tronco" loading="lazy"/>
            <span class="curiango-card-copy"><strong>Curiango</strong><em>Nyctidromus albicollis</em><small>Mãe da Lua e ave-símbolo da Viajar Travel News</small><b>Conheça sua história <i aria-hidden="true">→</i></b></span>
          </a>
        </div>
      </div>
    </article>

    <aside class="extras-rail" aria-label="Conteúdos complementares">
      <section class="rail-card categories-card"><p class="eyebrow">Explore o portal</p><h2>Vem com a gente</h2><div class="compact-categories">{categories.map(([title,href,image])=><a href={href}><img src={image} alt="" loading="lazy"/><span>{title}</span></a>)}</div></section>
      <section class="rail-card books-card"><p class="eyebrow">Boas histórias também viajam</p><h2>Jornada Literária</h2><ul><li><a target="_blank" rel="noopener" href="https://www.amyrklink.com.br/pt/livros/"><span><strong>Cem Dias Entre Céu e Mar</strong><small>Amyr Klink</small></span><b aria-hidden="true">→</b></a></li><li><a target="_blank" rel="noopener" href="https://thomazbrandolin.com.br/livros.php"><span><strong>Sozinho ao Redor do Mundo</strong><small>Thomaz Brandolin</small></span><b aria-hidden="true">→</b></a></li><li><a target="_blank" rel="noopener" href="https://www.amazon.com.br/volta-mundo-80-dias/dp/8594318146"><span><strong>A Volta ao Mundo em 80 Dias</strong><small>Júlio Verne</small></span><b aria-hidden="true">→</b></a></li></ul></section>
      <section class="rail-card partners-card"><p class="eyebrow">Caminham com a gente</p><h2>Parceiros</h2><div class="compact-partners">{partners.map(([name,href,image])=><a href={href} target="_blank" rel="noopener"><span class="partner-logo"><img src={image} alt="" loading="lazy"/></span><strong>{name}</strong></a>)}</div></section>
      <a class="panrotas-card" href="https://www.panrotas.com.br/" target="_blank" rel="noopener"><img src="/assets/partners/panrotas.png" alt="Panrotas" loading="lazy"/><span><small>Conteúdo do setor</small><strong>Portal PANROTAS</strong></span><b aria-hidden="true">→</b></a>
    </aside>
  </div>
</section>

<style>
  .videos,.reading{padding:clamp(4rem,8vw,7rem) 0}.heading{display:flex;align-items:end;justify-content:space-between;gap:2rem}.heading>p{max-width:280px;color:#687178}.video-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:2.5rem}.video-grid video{width:100%;aspect-ratio:9/14;background:#182127;object-fit:cover}.come{padding:clamp(4rem,8vw,7rem) 0;background:#f8f6f0}.category-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-top:2.5rem}.category-grid a{position:relative;min-height:350px;overflow:hidden;color:#fff}.category-grid a:after{position:absolute;inset:0;background:linear-gradient(0deg,#141d24d9,transparent 70%);content:''}.category-grid img{width:100%;height:100%;object-fit:cover}.category-grid span{position:absolute;z-index:1;right:1.4rem;bottom:1.4rem;left:1.4rem;font-family:var(--font-display);font-size:1.7rem}.full-moon{padding:clamp(4rem,8vw,7rem) 0;background:#222b31;color:#fff}.full-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,7vw,7rem);align-items:center}.full-grid img{width:100%;max-height:520px;object-fit:cover}.full-grid h2{margin:.7rem 0 1rem;font-family:var(--font-display);font-size:clamp(2.5rem,6vw,5rem);font-weight:400;line-height:1}.full-grid p:not(.eyebrow){color:#d9dfe1;line-height:1.8}.full-grid a{color:var(--color-vtn-green);font-weight:800;text-decoration:none}.reading-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(3rem,8vw,8rem)}.reading ul{margin:2rem 0 0;padding:0;list-style:none}.reading li a{display:flex;justify-content:space-between;gap:1rem;padding:1.2rem 0;border-bottom:1px solid #20282d1c;color:var(--color-vtn-ink);text-decoration:none}.reading li span{color:#6b747a}.partner-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:2rem}.partner-grid a{display:grid;min-height:115px;place-items:center;border:1px solid #20282d12;padding:1rem}.partner-grid img{max-width:110px;max-height:75px;object-fit:contain}.contact{padding:clamp(4rem,8vw,7rem) 0 2rem;background:#f6f5f0}.contact-grid{display:grid;grid-template-columns:repeat(4,1fr);margin-top:2.5rem;background:#ff7b4e;color:#fff}.contact article{min-height:150px;padding:1.6rem;border-right:1px solid #ffffff2a;border-bottom:1px solid #ffffff2a}.contact h3{margin:0 0 1rem;font-family:var(--font-display);font-size:1.1rem;font-weight:400}.contact article a{display:block;margin-top:.65rem;color:#fff;font-size:.9rem;overflow-wrap:anywhere;text-decoration:none}.contact footer{display:flex;justify-content:space-between;gap:1rem;padding-top:1.5rem;color:#626a70;font-size:.82rem}@media(max-width:850px){.video-grid{grid-template-columns:1fr}.category-grid{grid-template-columns:1fr 1fr}.full-grid,.reading-grid{grid-template-columns:1fr}.contact-grid{grid-template-columns:1fr 1fr}.heading{align-items:start;flex-direction:column}}@media(max-width:520px){.category-grid,.contact-grid{grid-template-columns:1fr}.contact footer{align-items:flex-start;flex-direction:column}}
  .videos{padding:clamp(3.5rem,6vw,5rem) 0}.video-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem;margin-top:2rem}.video-card[hidden]{display:none}.video-card video{display:block;width:100%;height:250px;aspect-ratio:auto;background:#182127;object-fit:cover}.video-copy{padding:1rem 0}.video-copy p{margin:0 0 .45rem;color:var(--color-vtn-orange);font-size:.68rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.video-copy h3{display:-webkit-box;min-height:2.55em;margin:0;overflow:hidden;font-family:var(--font-display);font-size:1.05rem;font-weight:400;line-height:1.28;-webkit-box-orient:vertical;-webkit-line-clamp:2}.video-actions{display:flex;justify-content:center;margin-top:1.5rem}.video-toggle{display:inline-flex;align-items:center;gap:.9rem;border:1px solid var(--color-vtn-orange);padding:.8rem 1.25rem;background:transparent;color:var(--color-vtn-orange);cursor:pointer;font:inherit;font-size:.75rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;transition:background-color .2s ease,color .2s ease,transform .2s ease}.video-toggle:hover,.video-toggle:focus-visible{background:var(--color-vtn-orange);color:#fff;transform:translateY(-2px)}.video-toggle:focus-visible{outline:3px solid #94c11f66;outline-offset:3px}@media(max-width:850px){.video-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:520px){.video-grid{grid-template-columns:1fr}.video-card video{height:280px}.video-copy h3{min-height:0}}
  .editorial-extras{padding:clamp(4rem,7vw,6.5rem) 0;background:#f6f4ed}.editorial-layout{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(300px,.78fr);gap:clamp(1.5rem,3.5vw,3.5rem);align-items:start}.moon-feature{overflow:hidden;background:#fff;box-shadow:0 18px 50px #222b3110}.moon-visual{position:relative;min-height:520px}.moon-visual:after{position:absolute;inset:0;background:linear-gradient(180deg,#0c151d16 20%,#0c151dbd 100%);content:''}.moon-visual>img{width:100%;height:100%;position:absolute;inset:0;object-fit:cover}.moon-heading{position:absolute;z-index:1;right:clamp(1.5rem,5vw,4rem);bottom:clamp(1.5rem,5vw,3.5rem);left:clamp(1.5rem,5vw,4rem);color:#fff}.moon-heading .eyebrow{color:#c7e64d}.moon-heading h2{max-width:680px;margin:.7rem 0 0;font-family:var(--font-display);font-size:clamp(3rem,6vw,5.4rem);font-weight:400;line-height:.95}.moon-copy{padding:clamp(1.6rem,4vw,3.25rem)}.moon-story{display:grid;grid-template-columns:minmax(0,1fr) 210px;gap:clamp(1.5rem,3vw,2.5rem);align-items:start}.moon-text p{margin:0 0 1rem;color:#59636a;font-size:.96rem;line-height:1.75}.moon-text .moon-signature{margin-bottom:0;color:#273138;font-family:var(--font-display);font-size:1.08rem}.curiango-card{overflow:hidden;border:1px solid #20282d14;background:#faf9f5;color:var(--color-vtn-ink);text-decoration:none;box-shadow:0 12px 30px #20282d12;transition:transform .25s ease,box-shadow .25s ease}.curiango-card:hover{transform:translateY(-3px);box-shadow:0 17px 35px #20282d1c}.curiango-card>img{width:100%;height:170px;object-fit:cover}.curiango-card-copy{display:block;padding:1.1rem}.curiango-card-copy>*{display:block}.curiango-card strong{font-family:var(--font-display);font-size:1.55rem;font-weight:400}.curiango-card em{margin-top:.2rem;color:#6d757a;font-family:var(--font-display);font-size:.85rem}.curiango-card small{margin-top:.85rem;color:#6d757a;font-size:.68rem;line-height:1.5;text-transform:uppercase}.curiango-card b{margin-top:1rem;color:var(--color-vtn-orange);font-size:.7rem;letter-spacing:.05em;text-transform:uppercase}.curiango-card b i{font-style:normal}.archive-link{display:flex;align-items:center;justify-content:space-between;margin-top:2rem;border-top:1px solid #20282d1a;padding-top:1.2rem;color:var(--color-vtn-orange);font-size:.76rem;font-weight:800;letter-spacing:.08em;text-decoration:none;text-transform:uppercase}.extras-rail{display:grid;gap:1rem}.rail-card{border-top:3px solid var(--color-vtn-orange);padding:1.5rem;background:#fff}.rail-card .eyebrow{margin-bottom:.35rem;font-size:.62rem}.rail-card h2{margin:0 0 1.2rem;font-family:var(--font-display);font-size:1.75rem;font-weight:400}.compact-categories{display:grid;grid-template-columns:1fr 1fr;gap:.5rem}.compact-categories a{position:relative;min-height:106px;overflow:hidden;color:#fff}.compact-categories a:after{position:absolute;inset:0;background:linear-gradient(0deg,#111a20dc,transparent 75%);content:''}.compact-categories img{width:100%;height:100%;position:absolute;object-fit:cover;transition:transform .35s ease}.compact-categories span{position:absolute;z-index:1;right:.75rem;bottom:.65rem;left:.75rem;font-family:var(--font-display);font-size:.92rem}.compact-categories a:hover img{transform:scale(1.05)}.books-card ul{margin:0;padding:0;list-style:none}.books-card li+li{border-top:1px solid #20282d14}.books-card a{display:flex;align-items:center;justify-content:space-between;gap:.7rem;padding:.8rem 0;color:var(--color-vtn-ink);text-decoration:none}.books-card strong,.books-card small{display:block}.books-card strong{font-size:.84rem}.books-card small{margin-top:.18rem;color:#7b8388;font-size:.72rem}.books-card b{color:var(--color-vtn-orange)}.compact-partners{display:grid;grid-template-columns:1fr 1fr;gap:.55rem}.compact-partners a{display:grid;grid-template-rows:58px auto;min-width:0;border:1px solid #20282d12;background:#faf9f5;color:var(--color-vtn-ink);text-align:center;text-decoration:none;transition:border-color .2s ease,transform .2s ease}.compact-partners a:hover{border-color:#f47721;transform:translateY(-2px)}.partner-logo{display:grid;place-items:center;padding:.55rem}.compact-partners img{max-width:100%;max-height:42px;object-fit:contain}.compact-partners strong{padding:.5rem .35rem;border-top:1px solid #20282d0f;font-size:.67rem;font-weight:600;line-height:1.2}.panrotas-card{display:grid;grid-template-columns:62px 1fr auto;align-items:center;gap:1rem;padding:1rem 1.25rem;background:#222b31;color:#fff;text-decoration:none}.panrotas-card img{width:62px;height:62px;object-fit:contain}.panrotas-card small,.panrotas-card strong{display:block}.panrotas-card small{color:#aeb7bb;font-size:.65rem;letter-spacing:.08em;text-transform:uppercase}.panrotas-card strong{margin-top:.22rem;font-family:var(--font-display);font-size:1.05rem;font-weight:400}.panrotas-card b{color:var(--color-vtn-green);font-size:1.2rem}@media(max-width:900px){.editorial-layout{grid-template-columns:1fr}.moon-visual{min-height:440px}.extras-rail{grid-template-columns:1fr 1fr}.panrotas-card{grid-column:1/-1}}@media(max-width:600px){.editorial-extras{padding:3rem 0}.moon-visual{min-height:380px}.moon-story{grid-template-columns:1fr}.curiango-card{display:grid;grid-template-columns:120px 1fr}.curiango-card>img{height:100%;min-height:190px}.extras-rail{grid-template-columns:1fr}.panrotas-card{grid-column:auto}}
  .contact-grid{grid-template-columns:repeat(3,minmax(0,1fr)) minmax(220px,.9fr);overflow:hidden;background:#ff7b4e;box-shadow:0 18px 45px #5d3b2d14}.contact article{min-height:132px;border:0;padding:1.7rem 2rem}.contact article h3{position:relative;margin-bottom:1.15rem}.contact article h3:after{display:block;width:28px;height:2px;margin-top:.65rem;background:#ffffff73;content:''}.contact article a{width:max-content;max-width:100%;margin-top:.55rem;opacity:.94;transition:opacity .2s ease,transform .2s ease}.contact article a:hover{opacity:1;transform:translateX(3px)}.contact article:last-child{grid-column:4;grid-row:1/span 2;display:flex;align-items:flex-start;flex-direction:column;justify-content:center;background:#e9653d}.contact article:last-child h3{font-size:1.35rem}.contact article:last-child a{display:inline-flex;align-items:center;margin-top:.8rem;border-bottom:1px solid #ffffff7a;padding-bottom:.2rem}.contact footer{padding-top:1.8rem}@media(max-width:850px){.contact-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.contact article:last-child{grid-column:1/-1;grid-row:auto;min-height:110px;align-items:center;flex-direction:row;justify-content:flex-start;gap:1.5rem}.contact article:last-child h3{margin:0 auto 0 0}.contact article:last-child h3:after{display:none}.contact article:last-child a{margin:0}}@media(max-width:560px){.contact-grid{grid-template-columns:1fr}.contact article{min-height:auto;padding:1.5rem}.contact article:last-child{grid-column:auto;align-items:flex-start;flex-direction:column;gap:.3rem}.contact article:last-child h3{margin:0 0 .75rem}.contact article:last-child a{margin-top:.35rem}}
  .contact-grid{grid-template-columns:repeat(3,minmax(0,1fr)) minmax(190px,.72fr)}.contact-column{padding:1rem 0}.contact-column article,.contact-column article:last-child{display:block;grid-column:auto;grid-row:auto;min-height:0;padding:1.15rem 1.75rem;background:transparent}.contact-column article+article{margin-top:.1rem}.contact-column article h3,.contact-column article:last-child h3{margin-bottom:.7rem;font-size:1.1rem}.contact-column article h3:after{display:block;width:24px;margin-top:.5rem}.contact-column article a,.contact-column article:last-child a{display:flex;align-items:baseline;width:max-content;max-width:100%;margin-top:.45rem;border:0;padding:0;gap:.45rem}.contact-symbol{flex:0 0 auto;color:#c9ef54;font-size:.75rem}.social-contact{grid-column:auto!important;grid-row:auto!important;display:block!important;min-height:100%!important;padding:2.2rem 1.7rem!important}.social-contact h3{margin-bottom:1.25rem!important}.social-links{display:flex;align-items:center;gap:1.2rem}.social-contact .social-links a{display:grid;width:42px;height:42px;margin:0!important;border:1px solid #ffffff5c!important;padding:10px!important;place-items:center}.social-contact svg{width:100%;height:100%;overflow:visible;fill:#fff}.social-contact .social-links a:hover{border-color:#fff!important;transform:translateY(-2px)}@media(max-width:900px){.contact-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.social-contact{grid-column:1/-1!important;display:flex!important;align-items:center!important;gap:1.5rem}.social-contact h3{margin:0 auto 0 0!important}.social-contact h3:after{display:none}}@media(max-width:560px){.contact-grid{grid-template-columns:1fr}.contact-column{padding:.5rem 0}.social-contact{grid-column:auto!important;align-items:flex-start!important;flex-direction:column}.social-contact h3{margin:0 0 .7rem!important}}
</style>
