---
import { hotels } from '../../data/home-content';
---
<section class="moon-wrap"><div class="container-vtn moon-grid">
  <article class="moon-card"><img src="/assets/moon/lua-do-cacador.png" alt="Lua cheia sobre campo após a colheita" loading="lazy"/><div class="moon-copy"><p class="eyebrow">Calendário lunar</p><h2>Próxima Lua Cheia</h2><strong>Lua do Caçador · Hunter’s Moon</strong><p class="date">25, 26 e 27 de outubro</p><p>Ápice em 26 de outubro, às 01h13 — Horário Oficial de Brasília.</p></div><div class="origin"><strong>Origem do nome</strong><p>É a lua cheia que surge logo após a Lua da Colheita. Com os campos limpos, sua luz permitia aos caçadores enxergar os animais enquanto se preparavam para o inverno.</p></div></article>
  <figure class="quote"><img src="/assets/moon/frase-do-mes.png" alt="Veleiro rumo ao mar aberto" loading="lazy"/><blockquote>“Daqui a vinte anos, você estará mais arrependido pelas coisas que não fez do que pelas que fez. Desamarre as amarras. Explore. Sonhe. Descubra.”</blockquote><figcaption>— Mark Twain</figcaption></figure>
</div></section>

<section class="route-strip" aria-labelledby="route-title">
  <div class="route-heading">
    <p>Rotas desta edição</p>
    <h2 id="route-title">Do litoral às montanhas</h2>
  </div>
  <img class="route-map" src="/assets/plane/mapa.png" alt="Rota entre Jericoacoara, Fortaleza, Galinhos, Pipa e Domingos Martins"/>
  <img class="route-aircraft" src="/assets/plane/aviao.png" alt="" aria-hidden="true"/>
</section>

<section id="rotas-destinos" class="hotels"><div class="container-vtn"><p class="feature-label">Destaque</p><h2 class="section-title">Hotéis que valem a visita</h2><div class="hotel-grid">
  {hotels.map(([name,place,href,image])=><article><img src={image} alt={name} loading="lazy"/><div><p>{place}</p><h3>{name}</h3><a href={href}>Leia mais →</a></div></article>)}
</div><div class="archive-actions"><a class="archive-link" href="/arquivo.html">Todas as matérias <span aria-hidden="true">→</span></a></div></div></section>

<style>
  .moon-wrap{padding:clamp(3rem,6vw,5rem) 0}.moon-grid{display:grid;grid-template-columns:1.5fr .8fr;gap:1.5rem}.moon-card,.quote{position:relative;min-height:440px;overflow:hidden;margin:0;background:#1b242a;color:#fff}.moon-card>img,.quote>img{width:100%;height:100%;object-fit:cover}.moon-card>img{object-position:center}.moon-copy{position:absolute;inset:0;padding:clamp(1.75rem,4vw,3.5rem);background:linear-gradient(90deg,#111b22e8,#111b2255 75%)}.moon-copy h2{margin:.55rem 0;font-family:var(--font-display);font-size:clamp(2.25rem,4vw,4rem);font-weight:400}.moon-copy>strong{color:#d6f495}.date{margin-top:1.35rem;color:var(--color-vtn-orange);font-size:1.2rem;font-weight:800}.origin{position:absolute;right:0;bottom:0;left:0;padding:1.1rem 1.7rem;background:#1f292fe8;backdrop-filter:blur(8px)}.origin p{margin:.3rem 0 0;color:#dce1e3;line-height:1.5}.quote:after{position:absolute;inset:0;background:linear-gradient(0deg,#131c22e8,#131c2244);content:''}.quote blockquote,.quote figcaption{position:absolute;z-index:1;right:2rem;left:2rem}.quote blockquote{bottom:4.2rem;margin:0;font-family:var(--font-display);font-size:clamp(1.15rem,1.8vw,1.65rem);line-height:1.35}.quote figcaption{bottom:2rem;color:var(--color-vtn-green);font-size:.78rem;font-weight:600;letter-spacing:.04em}.plane{position:relative;height:clamp(230px,33vw,440px);overflow:hidden;background:#f6f5f0}.map{width:100%;height:100%;object-fit:cover}.aircraft{position:absolute;top:50%;left:-20%;width:clamp(120px,18vw,260px);animation:fly 16s linear infinite}@keyframes fly{to{transform:translate(780%,-70%)}from{transform:translate(-10%,-50%)}}.hotels{padding:clamp(4rem,8vw,7rem) 0;background:#f8f6f0}.hotel-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:1rem;margin-top:2.5rem}.hotel-grid article{position:relative;grid-column:span 2;min-height:390px;overflow:hidden;background:#263038;color:#fff}.hotel-grid article:nth-child(4),.hotel-grid article:nth-child(5){grid-column:span 3}.hotel-grid article:after{position:absolute;inset:0;background:linear-gradient(0deg,#111b22e8,transparent 70%);content:''}.hotel-grid img{width:100%;height:100%;object-fit:cover}.hotel-grid article>div{position:absolute;z-index:1;right:1.5rem;bottom:1.5rem;left:1.5rem}.hotel-grid p{color:var(--color-vtn-green);font-size:.72rem;font-weight:800;text-transform:uppercase}.hotel-grid h3{margin:.3rem 0 1rem;font-family:var(--font-display);font-size:1.7rem;font-weight:400}.hotel-grid a{color:#fff;font-size:.73rem;font-weight:800;text-decoration:none;text-transform:uppercase}@media(prefers-reduced-motion:reduce){.aircraft{left:45%;animation:none}}@media(max-width:800px){.moon-grid{grid-template-columns:1fr}.moon-card,.quote{min-height:460px}.hotel-grid article,.hotel-grid article:nth-child(4),.hotel-grid article:nth-child(5){grid-column:1/-1}}
  @media(min-width:801px){.moon-wrap{padding:2rem 0}.moon-card,.quote{height:410px;min-height:0}}
  .route-strip{position:relative;height:290px;overflow:hidden;border-block:1px solid #20282d0d;background:#f7f6f1}.route-strip:after{position:absolute;inset:0;background:linear-gradient(90deg,#f7f6f1 0%,#f7f6f1e8 18%,transparent 42%);content:'';pointer-events:none}.route-map{position:absolute;top:0;left:-18%;width:136%;height:100%;object-fit:cover;object-position:center}.route-heading{position:absolute;z-index:2;top:50%;left:max(2rem,calc((100% - 1180px)/2));width:min(25rem,30vw);transform:translateY(-50%)}.route-heading p{margin:0 0 .7rem;color:var(--color-vtn-orange);font-size:.72rem;font-weight:800;letter-spacing:.15em;text-transform:uppercase}.route-heading h2{margin:0;font-family:var(--font-display);font-size:clamp(2rem,3.4vw,3.4rem);font-weight:400;line-height:1.05}.route-aircraft{position:absolute;z-index:3;bottom:2.2rem;left:18%;width:110px;filter:drop-shadow(0 8px 10px #20282d28);animation:route-flight 5s cubic-bezier(.2,.7,.25,1) .4s 1 both}@keyframes route-flight{from{opacity:0;transform:translate(-210px,55px) scale(.82)}35%{opacity:1}to{opacity:1;transform:translate(31vw,-42px) scale(.72)}}
  @media(max-width:800px){.route-strip{height:260px}.route-strip:after{background:linear-gradient(90deg,#f7f6f1f2,transparent 70%)}.route-map{left:-75%;width:220%;object-position:center}.route-heading{top:2rem;left:1.5rem;width:55%;transform:none}.route-heading h2{font-size:2rem}.route-aircraft{bottom:1.25rem;left:1.5rem;width:88px;animation:none;transform:none}}
  @media(prefers-reduced-motion:reduce){.route-aircraft{animation:none;transform:translate(42vw,-42px) scale(.72)}}
  @media(min-width:801px){.route-map{left:4%}.route-strip:after{background:linear-gradient(90deg,#f7f6f1 0%,#f7f6f1e8 20%,transparent 43%)}}
  @media(min-width:801px) and (prefers-reduced-motion:no-preference){.route-aircraft{animation-name:route-flight-final}}@keyframes route-flight-final{from{opacity:0;transform:translate(-210px,55px) scale(.82)}35%{opacity:1}to{opacity:1;transform:translate(42vw,-42px) scale(.72)}}
  @media(min-width:1100px){.hotel-grid{grid-template-columns:repeat(5,minmax(0,1fr));gap:.75rem}.hotel-grid article,.hotel-grid article:nth-child(4),.hotel-grid article:nth-child(5){grid-column:auto;min-height:370px}.hotel-grid article>div{right:1.1rem;bottom:1.2rem;left:1.1rem}.hotel-grid h3{font-size:1.35rem}}
  @media(min-width:801px) and (max-width:1099px){.hotel-grid article,.hotel-grid article:nth-child(4),.hotel-grid article:nth-child(5){grid-column:span 2;min-height:370px}.hotel-grid article:nth-child(4){grid-column:2/span 2}.hotel-grid article:nth-child(5){grid-column:4/span 2}}
  .feature-label{display:flex;align-items:center;gap:.85rem;margin:0 0 .75rem;color:var(--color-vtn-orange);font-family:var(--font-display);font-size:1.35rem;font-weight:400;letter-spacing:.08em;text-transform:uppercase}.feature-label:after{width:3rem;height:2px;background:var(--color-vtn-orange);content:''}.hotel-grid p{min-height:2.4em;margin:0;line-height:1.2}.hotel-grid h3{display:-webkit-box;min-height:2.45em;margin:.35rem 0 .85rem;overflow:hidden;line-height:1.18;-webkit-box-orient:vertical;-webkit-line-clamp:2}.hotel-grid a{display:block}
  @media(max-width:800px){.feature-label{font-size:1.15rem}.hotel-grid p,.hotel-grid h3{min-height:0}}
  .archive-actions{display:flex;justify-content:flex-end;margin-top:1.5rem}.archive-link{display:inline-flex;align-items:center;gap:1rem;padding:.9rem 1.3rem;background:var(--color-vtn-orange);box-shadow:0 8px 20px #e9651d24;color:#fff;font-size:.78rem;font-weight:800;letter-spacing:.06em;text-decoration:none;text-transform:uppercase;transition:background-color .2s ease,transform .2s ease}.archive-link span{font-size:1.15rem;transition:transform .2s ease}.archive-link:hover,.archive-link:focus-visible{background:#d95b17;transform:translateY(-2px)}.archive-link:hover span,.archive-link:focus-visible span{transform:translateX(3px)}.archive-link:focus-visible{outline:3px solid #94c11f66;outline-offset:3px}@media(max-width:800px){.archive-actions{justify-content:stretch}.archive-link{justify-content:space-between;width:100%}}
</style>
