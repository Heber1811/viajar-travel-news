---
import { contacts } from '../data/home-content';

const contactColumns = [
  [contacts[0], contacts[1]],
  [contacts[2], contacts[3]],
  [contacts[4], contacts[5]],
] as const;
---

<section id="contato" class="contact">
  <div class="container-vtn">
    <p class="eyebrow">Contato</p>
    <h2 class="section-title">Fale com a gente</h2>
    <div class="contact-grid">
      {contactColumns.map(column => (
        <div class="contact-column">
          {column.map(([role, phone, whatsapp, emails]) => (
            <article>
              <h3>{role}</h3>
              <a href={`https://wa.me/${whatsapp}`} target="_blank" rel="noopener"><span class="contact-symbol" aria-hidden="true">●</span>{phone}</a>
              {emails.map(email => <a href={`mailto:${email}`}><span class="contact-symbol" aria-hidden="true">✉</span>{email}</a>)}
            </article>
          ))}
        </div>
      ))}
      <article class="social-contact">
        <h3>Redes Sociais</h3>
        <div class="social-links">
          <a href="https://www.facebook.com/viajartravelnews/" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8h3V4.5c-.52-.07-2.3-.23-4.42-.23C8.17 4.27 5.15 6.9 5.15 11.72V16H0v3.91h5.15V30h6.31V19.91h5.27l.84-3.91h-6.11v-3.89C11.46 10.98 11.77 8 14 8Z" transform="scale(.75)"/></svg></a>
          <a href="https://www.instagram.com/viajartravelnews/" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 3.25.15 4.77 1.69 4.92 4.92.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.15 3.23-1.67 4.77-4.92 4.92-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-3.26-.15-4.77-1.7-4.92-4.92-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85C2.38 3.92 3.9 2.38 7.15 2.23 8.42 2.17 8.8 2.16 12 2.16ZM12 0C8.74 0 8.33.01 7.05.07 2.7.27.27 2.69.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.2 4.36 2.63 6.78 6.98 6.98C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c4.35-.2 6.78-2.62 6.98-6.98.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95C23.73 2.69 21.3.27 16.95.07 15.67.01 15.26 0 12 0Zm0 5.84A6.16 6.16 0 1 0 12 18.16 6.16 6.16 0 0 0 12 5.84Zm0 10.16A4 4 0 1 1 12 8a4 4 0 0 1 0 8Zm6.41-11.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88Z"/></svg></a>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .contact{padding:clamp(4rem,8vw,7rem) 0 2rem;background:#f6f5f0}
  .contact-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr)) minmax(190px,.72fr);margin-top:2.5rem;overflow:hidden;background:#ff7b4e;color:#fff;box-shadow:0 18px 45px #5d3b2d14}
  .contact-column{padding:1rem 0}
  article{min-height:0;padding:1.15rem 1.75rem}
  h3{position:relative;margin:0 0 .7rem;font-family:var(--font-display);font-size:1.1rem;font-weight:400}
  h3:after{display:block;width:24px;height:2px;margin-top:.5rem;background:#ffffff73;content:''}
  article a{display:flex;align-items:baseline;width:max-content;max-width:100%;margin-top:.45rem;gap:.45rem;color:#fff;font-size:.9rem;overflow-wrap:anywhere;text-decoration:none;opacity:.94;transition:opacity .2s ease,transform .2s ease}
  article a:hover{opacity:1;transform:translateX(3px)}
  .contact-symbol{flex:0 0 auto;color:#c9ef54;font-size:.75rem}
  .social-contact{min-height:100%;padding:2.2rem 1.7rem;background:#e9653d}
  .social-contact h3{margin-bottom:1.25rem;font-size:1.35rem}
  .social-links{display:flex;align-items:center;gap:1.2rem}
  .social-contact .social-links a{display:grid;width:42px;height:42px;margin:0;border:1px solid #ffffff5c;padding:10px;place-items:center}
  .social-contact svg{width:100%;height:100%;overflow:visible;fill:#fff}
  .social-contact .social-links a:hover{border-color:#fff;transform:translateY(-2px)}
  @media(max-width:900px){.contact-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.social-contact{grid-column:1/-1;display:flex;align-items:center;gap:1.5rem}.social-contact h3{margin:0 auto 0 0}.social-contact h3:after{display:none}}
  @media(max-width:560px){.contact-grid{grid-template-columns:1fr}.contact-column{padding:.5rem 0}.social-contact{grid-column:auto;align-items:flex-start;flex-direction:column}.social-contact h3{margin:0 0 .7rem}}
</style>
